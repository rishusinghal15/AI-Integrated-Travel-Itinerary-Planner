# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/travel-planner?retryWrites=true&w=majority

# Authentication (minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long

# Groq AI
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# CORS Allowed Origins (comma-separated for multiple origins in production)
CLIENT_URL=https://ai-integrated-travel-itinerary-plan.vercel.app
